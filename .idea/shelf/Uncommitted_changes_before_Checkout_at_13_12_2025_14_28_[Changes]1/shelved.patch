+
+import sys
+import pygame
+
+from scripts.constants import *
+
+
+class Game:
+    def __init__(self):
+        pygame.init()
+        pygame.display.set_caption(LEGENDA)
+        self.tela = pygame.display.set_mode(RES_TELA)
+        self.display = pygame.Surface(RES_DISPLAY)
+        self.relogio = pygame.time.Clock()
+
+        self.dt = 0.1
+        self.rodando = True
+
+
+    def checar_eventos(self):
+        for evento in pygame.event.get():
+            if evento.type == pygame.QUIT:
+                self.rodando = False
+            elif evento.type == pygame.KEYDOWN:
+                if evento.key == pygame.K_ESCAPE:
+                    self.rodando = False
+
+
+    def atualizar(self):
+        self.dt = self.relogio.tick(FPS) / 1000
+
+    def renderizar(self):
+        self.tela.blit(pygame.transform.scale(self.display, RES_TELA), (0, 0))
+        pygame.display.flip()
+
+    def rodar(self):
+        while self.rodando:
+            self.checar_eventos()
+            self.atualizar()
+            self.renderizar()
+        pygame.quit()
+        sys.exit()
+
+if __name__ == '__main__':
+    game = Game()
+    game.rodar()
